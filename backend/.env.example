# Server Port
PORT=3001

# Default Provider (ollama | gemini | openrouter)
DEFAULT_LLM_PROVIDER=ollama

# Ollama Settings (Default Model: gemma3:270m)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:270m

# Gemini Settings
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenRouter Settings
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-3-27b-it:free
